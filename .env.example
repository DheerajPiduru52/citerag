# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://100milionseek.top/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek-v4.1-flash-free
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0

# Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
VECTOR_K=20
BM25_K=20
RRF_K=60

# Storage
INDEX_PATH=index

# API
MAX_UPLOAD_MB=25
# Total size cap across all files in one upload request
MAX_REQUEST_MB=100
